# ------------------------------------------------------------------
# YutuHub 环境变量模板
#
#   cp .env.example .env.local   # 本地开发
#
# 原则：
#   - 只有 NEXT_PUBLIC_* 会被暴露到浏览器，其余变量仅服务端可见
#   - .env / .env.local 已被 .gitignore 排除，绝不提交
#   - 生产环境请在部署平台的 Secret 管理中配置，不要落盘
# ------------------------------------------------------------------

# 应用
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# 站点规范 URL。影响 sitemap.xml / robots.txt / canonical / OG，
# 生产环境必须设置为真实域名，否则搜索引擎会收录错误地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 数据库（Prisma / SQLite 本地文件）
# 本地开发可以直接用相对路径文件；生产环境建议换成托管数据库地址。
DATABASE_URL="file:./yutuhub.db"

# API 服务器（server/ 目录的 Express 服务）
API_PORT=3001
# 小程序调用后端时使用的公网地址，需在微信后台配置为合法域名
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# 会话签名密钥。生成方式：openssl rand -base64 32
# 留空则开发模式下使用不安全的默认值，生产环境必须设置。
SESSION_SECRET=

# 微信小程序（服务端调用 code2session 使用）
WECHAT_APPID=
WECHAT_SECRET=

# 对象存储（上传头像、项目封面，可选）
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# 分析统计（可选）
NEXT_PUBLIC_GA_MEASUREMENT_ID=
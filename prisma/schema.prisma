generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./yutuhub.db"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  phone           String?
  username        String    @unique
  displayName     String
  passwordHash    String
  campusId        String
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  termsAcceptedAt DateTime
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  reviews Review[]

  @@index([campusId])
  @@index([createdAt])
}

model Post {
  id            Int      @id @default(autoincrement())
  userId        Int      @default(0)
  categoryId    Int      @default(0)
  title         String
  content       String
  /// JSON-encoded array of image URLs (SQLite has no scalar list type).
  images        String   @default("[]")
  price         String?
  /// 0 = public author, 1 = anonymous.
  isAnonymous   Int      @default(0)
  /// 0 = pending, 1 = active, 2 = deleted, 3 = taken down.
  status        Int      @default(1)
  views         Int      @default(0)
  likeCount     Int      @default(0)
  favoriteCount Int      @default(0)
  commentCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([categoryId])
  @@index([likeCount])
  @@index([views])
}

model Course {
  id         Int      @id @default(autoincrement())
  name       String
  code       String
  department String
  credits    Float?
  campusId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  offerings CourseOffering[]

  @@index([campusId])
  @@index([department])
  @@index([name])
  @@index([code])
}

model Teacher {
  id         Int      @id @default(autoincrement())
  name       String
  department String
  campusId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  offerings CourseOffering[]

  @@index([campusId])
  @@index([department])
  @@index([name])
}

model CourseOffering {
  id        Int      @id @default(autoincrement())
  courseId  Int
  teacherId Int
  semester  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  teacher Teacher  @relation(fields: [teacherId], references: [id])
  reviews Review[]

  @@index([courseId])
  @@index([teacherId])
  @@index([semester])
}

model Review {
  id         Int @id @default(autoincrement())
  userId     Int
  offeringId Int

  overallRating Int
  difficulty    Int
  workload      Int
  grading       Int
  content       String

  isAnonymous Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  offering CourseOffering @relation(fields: [offeringId], references: [id])

  @@index([userId])
  @@index([offeringId])
  @@index([createdAt])
}
